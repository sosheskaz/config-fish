{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(deps)"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  // Cadence comes from the .github/workflows/renovate.yml cron. "at any time"
  // is renovate's no-restriction default, stated explicitly: a real window here
  // would make workflow_dispatch runs no-op outside it.
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [".worktrees/**"],
  "packageRules": [
    {
      "description": "Let a release settle before proposing it, so yanked or quickly-patched versions never reach a PR",
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "1 week"
    },
    {
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      // automergeType "pr" is GitHub-native auto-merge: it still waits on
      // required checks rather than bypassing them.
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions",
      "pinDigests": true,
      "versioning": "semver",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["mise"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "mise"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      // renovate declares engines.node "^24"; a node major bump breaks the
      // renovate workflow itself, so it never lands unattended.
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Majors always get a human",
      "matchUpdateTypes": ["major"],
      "addLabels": ["MAJOR UPDATE"],
      "automerge": false
    }
  ]
}
